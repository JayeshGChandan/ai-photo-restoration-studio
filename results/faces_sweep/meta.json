{
  "evaluation": "faces_sweep",
  "description": "CodeFormer at fidelity 0.3, 0.7 and 1.0 vs Real-ESRGAN only vs bicubic, at two damage levels, on the face box of the CLIC 2020 images with a face at least 64 px on its larger side",
  "started": "2026-10-27T01:08:57+05:30",
  "fidelity_direction": {
    "source": "restorers/face.py module docstring and _restore_crop()",
    "code": "self._raw(t, weight=float(fidelity)): the fidelity value is passed unchanged as CodeFormer's weight w",
    "docstring": "0.0 leans on the generative prior for maximum quality (can subtly alter identity), 1.0 stays faithful to the input (but preserves more of its degradation). ~0.7 is a good default for old photos.",
    "reading": "1.0 = most faithful to the (degraded) input; 0.0 = most generative"
  },
  "selection": {
    "rule": "largest face in results/faces/meta.json with max(width, height) >= 64 px",
    "images": [
      "mobile/20151208_222739.png",
      "mobile/20171109_082958.png",
      "mobile/IMG_1502.png",
      "mobile/IMG_1696.png",
      "mobile/IMG_20170315_171546.png",
      "professional/dogancan-ozturan-395.png",
      "professional/roberto-nickson-48063.png"
    ],
    "detections_rechecked": "Diagnose's detector is re-run on every full image and its largest box must equal meta.json"
  },
  "parameters": {
    "crop": "scripts/eval_faces.py square_crop + map_box: square of side 2 x the larger side of the largest face, centred on it, LANCZOS to 512x512",
    "levels": {
      "mild": {
        "downscale_factor": 2,
        "blur_sigma": 1.0,
        "noise_sigma": 8.0,
        "jpeg_quality": 60
      },
      "severe": {
        "downscale_factor": 4,
        "blur_sigma": 2.0,
        "noise_sigma": 15.0,
        "jpeg_quality": 30
      }
    },
    "level_order": "run_benchmark/degrade: blur, then downscale (cv2 INTER_AREA), then Gaussian noise (seed), then JPEG; restore outscale = downscale factor",
    "seed": 0,
    "fidelities": [
      0.3,
      0.7,
      1.0
    ],
    "run_benchmark_defaults": {
      "downscale_factor": 2,
      "blur_sigma": 1.0,
      "noise_sigma": 8.0,
      "jpeg_quality": 60,
      "do_face": true,
      "fidelity": 0.7,
      "score": true,
      "seed": 0
    },
    "calls": "run_benchmark(clean, **level, do_face=False, seed=0, score=False) and run_benchmark(clean, **level, do_face=True, fidelity=f, seed=0, score=False) for f in fidelities",
    "scoring": {
      "psnr_y, ssim_y, lpips": "IQAScorer.score_reference(out face box, clean face box)",
      "musiq": "IQAScorer._score_one('musiq', out face box), pyiqa default",
      "identity_cos": "dot product of L2-normalised ArcFace embeddings, output vs clean, aligned with the clean-crop landmarks"
    },
    "identity_model": {
      "available_in_facexlib": true,
      "module": "facexlib.recognition (init_recognition_model('arcface'))",
      "architecture": "Backbone(num_layers=50, drop_ratio=0.6, mode='ir_se'), built directly because init_recognition_model hard-codes .to('cuda')",
      "weights_url": "https://github.com/xinntao/facexlib/releases/download/v0.1.0/recognition_arcface_ir_se50.pth",
      "weights_source": "official facexlib release v0.1.0, downloaded with facexlib.utils.load_file_from_url to facexlib's default weights folder",
